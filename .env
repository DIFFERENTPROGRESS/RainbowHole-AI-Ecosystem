# ═══════════════════════════════════════════════════
# RainbowHole V0 — Node Configuration
# ═══════════════════════════════════════════════════

# Node identity: "local" (laptop) or "remote" (VPS)
NODE_TYPE=local

# Inference routing: "local", "remote", or "auto"
# auto = try remote first, fallback to local
BRAIN_MODE=local

# Remote VPS endpoint
VPS_URL=

# Shared secret for inter-node authentication
API_KEY=233802133db9739680f8aa66

# Local model (must fit in 8GB RAM)
LOCAL_MODEL=phi3:mini

# Ollama endpoint (local inference backend)
OLLAMA_URL=http://localhost:11434

# Vault storage path
VAULT_PATH=./vault

# Heartbeat interval in seconds
HEARTBEAT_INTERVAL=10

# API server config
API_HOST=0.0.0.0
API_PORT=8000
